@startuml
!theme plain
autonumber

actor User as U
participant "ac:AirConditioner" as O0
participant "term:Thermostat" as O1
participant "owner:HomeOwner" as O2

U -> O0 : <<create>> AirConditioner()

U -> O1 : <<create>> Thermostat(ac)

U -> O2 : <<create>> HomeOwner(term)

U -> O2 : comeHome()
activate O2
    O2 -> O1 : setDesiredTemp(22)
    activate O1
        O1 -> O0 : startCooling(temp)
        activate O0
        O0 --> O1
        deactivate O0
    O1 --> O2
    deactivate O1
O2 --> U
deactivate O2
@enduml